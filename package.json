{
  "name": "chat-runtime-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint .",
    "test": "vitest run",
    "example:smoke": "pnpm --filter @chat-runtime/hono-control-plane smoke",
    "image:build": "docker build -t chat-runtime:local .",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm build && pnpm example:smoke",
    "dev:runtime": "pnpm --filter @chat-runtime/runtime dev",
    "dev:control-plane": "pnpm --filter @chat-runtime/hono-control-plane dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.1"
  }
}

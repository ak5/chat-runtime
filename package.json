{
  "name": "chat-runtime-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint .",
    "test": "vitest run",
    "api:smoke": "pnpm --filter @chat-runtime/api smoke",
    "image:build": "docker build -t chat-runtime:local .",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm build && pnpm api:smoke",
    "dev:runtime": "pnpm --filter @chat-runtime/runtime dev",
    "dev:api": "pnpm --filter @chat-runtime/api dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  }
}
